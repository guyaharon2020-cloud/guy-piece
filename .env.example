# Anthropic (Claude) API key - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (Meta for Developers -> your app -> WhatsApp -> API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Any string you choose - must match the "Verify token" you enter in the
# Meta webhook configuration screen.
WHATSAPP_VERIFY_TOKEN=

# App secret (Meta app -> Settings -> Basic -> App secret) - used to verify
# that incoming webhook requests really came from Meta.
WHATSAPP_APP_SECRET=

# Optional
PORT=3000
CLAUDE_MODEL=claude-opus-5
SYSTEM_PROMPT="You are a helpful, friendly assistant chatting with the user over WhatsApp. Keep replies concise and conversational."
