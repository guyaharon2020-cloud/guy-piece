Worlds.List = {
	{
		id = "Backyard",
		name = "Backyard",
		order = 1,
		unlockCost = 0, -- starting world
		parts = backyard,
	},
	{
		id = "Laboratory",
		name = "Laboratory",
		order = 2,
		unlockCost = 500,
		parts = laboratory,
	},
	{
		id = "AlienPlanet",
		name = "Alien Planet",
		order = 3,
		unlockCost = 3000,
		parts = alienPlanet,
